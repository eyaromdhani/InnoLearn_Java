<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.Controllers.PPController"
      prefWidth="1200.0" prefHeight="700.0"
      style="-fx-background-color: #f0f0f5;">

    <!-- NAVBAR -->
    <HBox style="-fx-background-color:  linear-gradient(to right, #1a0050, #3a0ca3); -fx-padding: 15 30 15 30;"
          alignment="CENTER" spacing="60">
        <Label text="🎓 InnoLearn"
               style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="60" HBox.hgrow="ALWAYS">
            <Button text="Accueil" onAction="#ouvrirAccueilPrincipal"
                    style="-fx-background-color: transparent;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Cours" onAction="#ouvrirCours"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
               -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Projets" onAction="#ouvrirProjets"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Button text="Opportunités" onAction="#ouvrirOpportunites"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Button text="Événements"  onAction="#ouvrirEvenements"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Button text="Quiz" onAction="#ouvrirQuiz"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- HERO SECTION -->
    <HBox style="-fx-background-color: linear-gradient(to right, #3a0ca3, #7209b7);"
          prefHeight="300" alignment="CENTER_LEFT" spacing="40">
        <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

        <VBox spacing="15" alignment="CENTER_LEFT">
            <Label text="CATALOGUE INNOLEARN"
                   style="-fx-background-color: rgba(255,255,255,0.2);
                          -fx-text-fill: white;
                          -fx-padding: 5 15 5 15;
                          -fx-background-radius: 20;
                          -fx-font-size: 12px;"/>
            <VBox spacing="5">
                <Label text="Explorez les"
                       style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                <Label text="Meilleures Catégories"
                       style="-fx-text-fill: #f8c537; -fx-font-size: 36px; -fx-font-weight: bold;"/>
            </VBox>

            <ComboBox fx:id="categorieCombo" promptText="Toutes les catégories"
                      prefWidth="280"
                      style="-fx-background-color: white;
                             -fx-background-radius: 25;
                             -fx-padding: 8 15 8 15;"/>

            <TextField fx:id="searchField" promptText="Rechercher une catégorie..."
                       prefWidth="280"
                       style="-fx-background-color: white;
                              -fx-background-radius: 25;
                              -fx-padding: 8 15 8 15;
                              -fx-border-color: transparent;"/>
            <ComboBox fx:id="triCombo" promptText="🔃 Trier par : Plus récents"
                      prefWidth="280"
                      style="-fx-background-color: white;
                 -fx-background-radius: 25;
                 -fx-padding: 8 15 8 15;"/>
        </VBox>

        <HBox HBox.hgrow="ALWAYS"/>

        <!-- Cercle décoratif avec vrai emoji personnage -->
        <StackPane prefWidth="280" prefHeight="280"
                   style="-fx-background-color: rgba(255,255,255,0.15);
                  -fx-background-radius: 200;">
            <ImageView fitWidth="250" fitHeight="250" preserveRatio="true">
                <image>
                    <Image url="@/assets/student.png"/>
                </image>
            </ImageView>
        </StackPane>
    </HBox>

    <!-- SECTION TITRE -->
    <VBox alignment="CENTER" style="-fx-padding: 30 0 10 0;">
        <Label text="Catégories disponibles"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
    </VBox>

    <!-- CARDS SECTION -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <FlowPane fx:id="cardsContainer"
                  hgap="20" vgap="20"
                  style="-fx-padding: 20 40 20 40; -fx-background-color: #f0f0f5;">


        </FlowPane>
    </ScrollPane>

</VBox>