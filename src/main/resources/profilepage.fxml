<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.Controllers.UserProfileController"
            prefWidth="1200" prefHeight="800"
            styleClass="root-pane" stylesheets="@master.css">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="260">
            <HBox styleClass="logo-box" alignment="CENTER_LEFT">
                <Label styleClass="logo-icon" text="✦"/>
                <Label styleClass="logo-text" text="InnoLearn"/>
            </HBox>

            <VBox styleClass="nav-section" VBox.vgrow="ALWAYS" spacing="5">
                <Button fx:id="navHome" styleClass="nav-btn" text="⬛  Dashboard" onAction="#goToHome"/>
                <Button styleClass="nav-btn, nav-active" text="◉  My Profile"/>
                <Button fx:id="navCourses" styleClass="nav-btn" text="▦  My Courses" onAction="#goToCourses"/>
                <Button fx:id="navProjects" styleClass="nav-btn" text="◈  Projects" onAction="#goToProjects"/>
                <Button fx:id="navEvents" styleClass="nav-btn" text="◆  Events" onAction="#goToEvents"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button styleClass="delete-btn" text="🗑 Delete Account" onAction="#deleteAccount" opacity="0.6"/>
            </VBox>

            <Button styleClass="logout-btn" text="⇠  Sign Out" onAction="#logout" style="-fx-text-fill: #ef4444; -fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 20 25;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane styleClass="main-scroll" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
            <content>
                <VBox styleClass="main-content" spacing="30" style="-fx-padding: 40 60;">

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label styleClass="title-main" text="Account Settings"/>
                            <Label styleClass="subtitle-main" text="Manage your digital identity and learning credentials."/>
                        </VBox>
                        <Button styleClass="btn-primary" text="✎  Edit Profile" onAction="#toggleEdit" style="-fx-padding: 10 20;"/>
                    </HBox>

                    <!-- Profile Card -->
                    <HBox styleClass="premium-card" spacing="40" alignment="CENTER_LEFT">
                        <VBox alignment="CENTER" spacing="15">
                            <StackPane>
                                <Circle radius="60" fill="transparent" stroke="#e2e8f0" strokeWidth="2"/>
                                <Label fx:id="avatarInitials" text="JD" style="-fx-text-fill: #7c3aed; -fx-font-size: 36px; -fx-font-weight: 900;"/>
                            </StackPane>
                            <Label fx:id="lblRole" text="STUDENT" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-padding: 5 15; -fx-background-radius: 20; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        </VBox>

                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblFullName" text="Jihen Student" style="-fx-text-fill: #1e1b4b; -fx-font-size: 26px; -fx-font-weight: 900;"/>
                            <Label fx:id="lblEmail" text="jihen@innolearn.com" style="-fx-text-fill: #7c3aed; -fx-font-size: 14px;"/>
                            
                            <HBox spacing="40" style="-fx-padding: 15 0 0 0;">
                                <VBox><Label styleClass="label-caps" text="USERNAME"/><Label fx:id="lblUsername" text="java" style="-fx-font-weight: bold; -fx-text-fill: #1e1b4b;"/></VBox>
                                <VBox><Label styleClass="label-caps" text="PHONE"/><Label fx:id="lblPhone" text="98104802" style="-fx-font-weight: bold; -fx-text-fill: #1e1b4b;"/></VBox>
                                <VBox><Label styleClass="label-caps" text="STATUS"/><Label fx:id="lblStatus" text="● ACTIVE" style="-fx-text-fill: #22c55e; -fx-font-weight: bold;"/></VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Edit Form -->
                    <VBox fx:id="editForm" styleClass="premium-card" spacing="25" managed="false" visible="false">
                        <Label text="Edit Information" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e1b4b;"/>
                        <GridPane hgap="20" vgap="20">
                            <columnConstraints><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0"><Label styleClass="label-caps" text="FULL NAME"/><TextField fx:id="fieldName" styleClass="pill-input"/></VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0"><Label styleClass="label-caps" text="USERNAME"/><TextField fx:id="fieldUsername" styleClass="pill-input"/></VBox>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label styleClass="label-caps" text="EMAIL"/><TextField fx:id="fieldEmail" styleClass="pill-input"/></VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label styleClass="label-caps" text="PHONE"/><TextField fx:id="fieldPhone" styleClass="pill-input"/></VBox>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2"><Label styleClass="label-caps" text="PASSWORD"/><PasswordField fx:id="fieldPassword" styleClass="pill-input"/></VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2"><Label styleClass="label-caps" text="CONFIRM"/><PasswordField fx:id="fieldConfirmPassword" styleClass="pill-input"/></VBox>
                        </GridPane>
                        <HBox spacing="15" alignment="CENTER_RIGHT">
                            <Button text="Cancel" onAction="#cancelEdit" styleClass="btn-secondary"/>
                            <Button text="Save Changes" onAction="#saveProfile" styleClass="btn-primary"/>
                        </HBox>
                    </VBox>

                    <!-- Stats -->
                    <HBox spacing="20">
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="07" styleClass="title-main"/><Label text="COURSES ENROLLED" styleClass="label-caps"/></VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="03" styleClass="title-main"/><Label text="ACTIVE PROJECTS" styleClass="label-caps"/></VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="12" styleClass="title-main"/><Label text="QUIZZES TAKEN" styleClass="label-caps"/></VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="85%" styleClass="title-main" style="-fx-text-fill: #7c3aed;"/><Label text="AVG. SCORE" styleClass="label-caps"/></VBox>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
