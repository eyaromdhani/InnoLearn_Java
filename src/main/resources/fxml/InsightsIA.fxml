<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox spacing="30.0" style="-fx-background-color: #f8fafc; -fx-padding: 30;" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.InsightsIAController">
    <children>
        <!-- Header Stats -->
        <HBox spacing="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12; -fx-font-weight: bold;" text="OFFRES DISPONIBLES" />
                                <Label fx:id="lblOffresCount" style="-fx-font-size: 24; -fx-font-weight: 800;" text="28" />
                            </children>
                        </VBox>
                        <StackPane style="-fx-background-color: #e0e7ff; -fx-background-radius: 10; -fx-padding: 10;">
                            <children>
                                <SVGPath content="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" fill="#6366f1" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12; -fx-font-weight: bold;" text="MES CANDIDATURES" />
                                <Label fx:id="lblCandidaturesCount" style="-fx-font-size: 24; -fx-font-weight: 800;" text="8" />
                            </children>
                        </VBox>
                        <StackPane style="-fx-background-color: #e0e7ff; -fx-background-radius: 10; -fx-padding: 10;">
                            <children>
                                <SVGPath content="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" fill="#6366f1" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12; -fx-font-weight: bold;" text="ACCEPTÉES" />
                                <Label fx:id="lblAcceptedCount" style="-fx-font-size: 24; -fx-font-weight: 800;" text="2" />
                            </children>
                        </VBox>
                        <StackPane style="-fx-background-color: #dcfce7; -fx-background-radius: 10; -fx-padding: 10;">
                            <children>
                                <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="#22c55e" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12; -fx-font-weight: bold;" text="EN ATTENTE" />
                                <Label fx:id="lblPendingCount" style="-fx-font-size: 24; -fx-font-weight: 800;" text="0" />
                            </children>
                        </VBox>
                        <StackPane style="-fx-background-color: #fef9c3; -fx-background-radius: 10; -fx-padding: 10;">
                            <children>
                                <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="#eab308" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
            </children>
        </HBox>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="#6366f1" scaleX="1.2" scaleY="1.2" />
                <Label style="-fx-font-size: 22; -fx-font-weight: 800; -fx-text-fill: #1e293b;" text="Insights de Carrière IA" />
            </children>
        </HBox>

        <GridPane hgap="30.0" vgap="30.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="30.0" />
                <ColumnConstraints percentWidth="70.0" />
            </columnConstraints>
            <children>
                <!-- Left Card: Force de Profil -->
                <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);" GridPane.columnIndex="0">
                    <children>
                        <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-weight: bold; -fx-text-fill: #64748b;" text="Force de Profil" />
                        <StackPane prefHeight="200.0" prefWidth="200.0">
                            <children>
                                <Circle fill="TRANSPARENT" radius="70.0" stroke="#f1f5f9" strokeWidth="15.0" />
                                <Circle fx:id="circleProgress" fill="TRANSPARENT" radius="70.0" stroke="#6366f1" strokeDashArray="439.8" strokeDashOffset="88.0" strokeLineCap="ROUND" strokeWidth="15.0" rotate="-90" />
                                <Label fx:id="lblStanding" style="-fx-font-size: 36; -fx-font-weight: 900; -fx-text-fill: #6366f1;" text="80%" />
                            </children>
                        </StackPane>
                        <TextFlow textAlignment="CENTER">
                            <children>
                                <Text fx:id="txtContext" style="-fx-fill: #64748b; -fx-font-size: 13;" text="Votre positionnement actuel par rapport aux attentes des recruteurs dans votre domaine." />
                            </children>
                        </TextFlow>
                    </children>
                </VBox>

                <!-- Right Content -->
                <VBox spacing="30.0" GridPane.columnIndex="1">
                    <children>
                        <!-- Compétences à consolider -->
                        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <StackPane style="-fx-background-color: #6366f122; -fx-background-radius: 10; -fx-padding: 8;">
                                            <children>
                                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm0-12c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4z" fill="#6366f1" />
                                            </children>
                                        </StackPane>
                                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Compétences à consolider" />
                                    </children>
                                </HBox>
                                <FlowPane fx:id="flowSkillGaps" hgap="10.0" vgap="10.0">
                                    <!-- Pills will be injected here -->
                                </FlowPane>
                            </children>
                        </VBox>

                        <!-- Plan d'action -->
                        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <StackPane style="-fx-background-color: #6366f122; -fx-background-radius: 10; -fx-padding: 8;">
                                            <children>
                                                <SVGPath content="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" fill="#6366f1" />
                                            </children>
                                        </StackPane>
                                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Votre plan d'action personnalisé" />
                                    </children>
                                </HBox>
                                <VBox fx:id="vboxActionPlan" spacing="15.0">
                                    <!-- Steps will be injected here -->
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </GridPane>
    </children>
</VBox>
