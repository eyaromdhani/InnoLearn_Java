<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.Controllers.PageAdminModifierCategorieController"
      prefWidth="1200.0" prefHeight="700.0"
      style="-fx-background-color: #f0f0f5;">

    <HBox style="-fx-background-color: #1a1a2e; -fx-padding: 15 30 15 30;"
          alignment="CENTER" spacing="60">
        <Label text="👑 InnoLearn Admin"
               style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="60" HBox.hgrow="ALWAYS">
            <Button text="&lt; Retour aux Catégories" onAction="#onAnnulerClick"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <VBox alignment="TOP_CENTER" maxWidth="600.0" spacing="15.0" 
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3); -fx-padding: 40;">
              
            <Label text="Modifier la Catégorie" 
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e; -fx-padding: 0 0 20 0;" />

            <GridPane hgap="15.0" vgap="25.0" alignment="CENTER">
                <Label text="Titre de la catégorie :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <TextField fx:id="tfTitre" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300.0" />
                
                <Label text="Description :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <TextArea fx:id="taDescription" styleClass="text-area" prefHeight="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300.0" />
                
                <Label text="Niveau de difficulté :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <ComboBox fx:id="cbNiveau" styleClass="combo-box" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>

            <HBox alignment="CENTER_RIGHT" spacing="20.0">
                <padding>
                    <Insets top="30.0" />
                </padding>
                <Button mnemonicParsing="false" onAction="#onAnnulerClick" text="Annuler" 
                        style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-weight: bold; -fx-cursor: hand;" />
                <Button mnemonicParsing="false" onAction="#onMettreAJourClick" text="Mettre à jour" 
                        style="-fx-background-color: #f72585; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 25 10 25; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </VBox>
</VBox>
