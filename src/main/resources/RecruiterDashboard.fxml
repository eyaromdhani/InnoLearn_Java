<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane fitToWidth="true" styleClass="main-scroll-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controllers.RecruiterDashboardController">
    <content>
        <VBox spacing="0.0" styleClass="home-container">
            <children>
                <!-- Hero Section for Recruiter -->
                <VBox styleClass="recruiter-hero-container">
                    <children>
                        <!-- Top Navbar -->
                        <fx:include fx:id="navbar" source="Navbar.fxml" />

                        <HBox alignment="CENTER_LEFT" spacing="50.0">
                            <children>
                                <!-- Left Content -->
                                <VBox alignment="CENTER_LEFT" spacing="25.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" maxWidth="-Infinity" styleClass="recruiter-badge">
                                            <children>
                                                <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;" text="ESPACE RECRUTEUR" />
                                            </children>
                                        </HBox>

                                        <VBox spacing="0.0">
                                            <children>
                                                <Label styleClass="recruiter-title" text="Découvrez les" />
                                                <Label styleClass="recruiter-title recruiter-title-highlight" text="Opportunités" />
                                            </children>
                                        </VBox>

                                        
                                        <HBox spacing="10.0">
                                            <children>
                                                <Button fx:id="btnPublier" maxWidth="Infinity" onAction="#handlePublish" styleClass="btn-primary" text="Publier un stage" />
                                                <Button mnemonicParsing="false" onAction="#handleMyOffers" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 25px; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Les Offres" />
                                                <Button mnemonicParsing="false" onAction="#handleCandidatures" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 25px; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Candidatures" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Right Illustration (3D Recruiter) -->
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <children>
                                        <StackPane styleClass="hero-image-container">
                                            <children>
                                                <Circle fx:id="heroCircle" radius="180.0" styleClass="hero-circle-image" fill="#ffffff22" stroke="WHITE" strokeWidth="2" strokeDashArray="10, 10" />
                                                <!-- We can add an ImageView here for the recruiter illustration -->
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>
                            </children>
                            <padding>
                                <Insets bottom="60.0" left="80.0" right="80.0" top="40.0" />
                            </padding>
                        </HBox>
                    </children>
                </VBox>

                <!-- KPI Cards Section (Dynamic) -->
                <HBox spacing="30.0" alignment="CENTER" pickOnBounds="false" style="-fx-padding: 0 40 40 40; -fx-translate-y: -40;">
                    <children>
                        <!-- Card 1: Total My Offers -->
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="kpi-label" text="MES OFFRES" />
                                                <Label fx:id="lblStatMyOffers" styleClass="kpi-value" text="0" />
                                            </children>
                                        </VBox>
                                        <StackPane styleClass="kpi-icon-container" style="-fx-background-color: rgba(99, 102, 241, 0.1);">
                                            <children>
                                                <SVGPath content="M21 16.5c0 .38-.21.71-.53.88l-7.97 4.27a1.006 1.006 0 01-.94 0l-7.97-4.27A1 1 0 013 16.5V7.5c0-.38.21-.71.53-.88l7.97-4.27a1.006 1.006 0 01.94 0l7.97 4.27c.32.17.53.5.53.88v9z" fill="#6366f1" scaleX="0.9" scaleY="0.9" />
                                            </children>
                                        </StackPane>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Card 2: Total Candidatures -->
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="kpi-label" text="CANDIDATURES" />
                                                <Label fx:id="lblStatMyApps" styleClass="kpi-value" text="0" />
                                            </children>
                                        </VBox>
                                        <StackPane styleClass="kpi-icon-container" style="-fx-background-color: rgba(34, 197, 94, 0.1);">
                                            <children>
                                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="#22c55e" scaleX="0.9" scaleY="0.9" />
                                            </children>
                                        </StackPane>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Card 3: Pending Reviews -->
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="kpi-label" text="EN ATTENTE" />
                                                <Label fx:id="lblStatPending" styleClass="kpi-value" text="0" />
                                            </children>
                                        </VBox>
                                        <StackPane styleClass="kpi-icon-container" style="-fx-background-color: rgba(245, 158, 11, 0.1);">
                                            <children>
                                                <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="#f59e0b" scaleX="0.9" scaleY="0.9" />
                                            </children>
                                        </StackPane>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Main Content Area -->
                <VBox pickOnBounds="false" spacing="30.0" style="-fx-padding: 0 40 40 40;">
                    <children>
                        <!-- Modern Filter Area (Double Row) -->
                        <VBox spacing="20.0" styleClass="filter-row">
                            <children>
                                <!-- Row 1: Search, Company, Domain -->
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-input-container" HBox.hgrow="ALWAYS">
                                            <children>
                                                <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" styleClass="filter-icon" />
                                                <TextField fx:id="txtSearch" promptText="Rechercher une offre ou un candidat..." HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                        
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-input-container" prefWidth="250.0">
                                            <children>
                                                <SVGPath content="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm14 12h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V9h2v2zm0-4h-2V5h2v2zm-2 1h-8v8h8v-8z" styleClass="filter-icon" />
                                                <ComboBox fx:id="comboEnterprise" promptText="Toutes les entreprises" prefWidth="200.0" />
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-input-container" prefWidth="250.0">
                                            <children>
                                                <SVGPath content="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6 10H6v-2h8v2zm4-4H6v-2h12v2z" styleClass="filter-icon" />
                                                <ComboBox fx:id="comboDomaine" promptText="Tous les domaines" prefWidth="200.0" />
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <!-- Row 2: Duration, Sort -->
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-input-container" prefWidth="180.0">
                                            <children>
                                                <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" styleClass="filter-icon" />
                                                <ComboBox fx:id="comboDuration" promptText="Durées" prefWidth="130.0" />
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-input-container" prefWidth="180.0">
                                            <children>
                                                <SVGPath content="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" styleClass="filter-icon" />
                                                <ComboBox fx:id="comboSort" promptText="Plus récents" prefWidth="130.0" />
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Section Header -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Nos Offres de Stage" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblCount" style="-fx-text-fill: #64748b; -fx-font-weight: 600;" text="0 Offres" />
                            </children>
                        </HBox>

                        <!-- Cards Grid -->
                        <FlowPane fx:id="cardsContainer" hgap="30.0" vgap="30.0" styleClass="content-area">
                            <!-- Dynamically loaded cards -->
                        </FlowPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
