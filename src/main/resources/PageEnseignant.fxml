<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.Controllers.PageEnseignantController"
      prefWidth="1200.0" prefHeight="700.0"
      style="-fx-background-color: #f0f0f5;">

    <!-- NAVBAR -->
    <HBox style="-fx-background-color: #3a0ca3; -fx-padding: 15 30 15 30;"
          alignment="CENTER_LEFT" spacing="20">
        
        <Button onAction="#onBackClick" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;">
            <graphic>
                <javafx.scene.shape.SVGPath content="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" fill="white" scaleX="1.2" scaleY="1.2" />
            </graphic>
        </Button>

        <Label text="🎓 InnoLearn"
               style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="60" HBox.hgrow="ALWAYS">
            <Button text="⬅ Accueil Principal" onAction="#onRetourAccueilClick"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Mes Cours"
                    style="-fx-background-color: transparent;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;"/>
            <Button text="Quiz" onAction="#onGestionQuizClick"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Button text="Planifications"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- HERO SECTION -->
    <HBox style="-fx-background-color: linear-gradient(to right, #3a0ca3, #7209b7);"
          prefHeight="250" alignment="CENTER_LEFT" spacing="40">
        <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

        <VBox spacing="15" alignment="CENTER_LEFT">
            <Label text="ESPACE ENSEIGNANT"
                   style="-fx-background-color: rgba(255,255,255,0.2);
                          -fx-text-fill: white;
                          -fx-padding: 5 15 5 15;
                          -fx-background-radius: 20;
                          -fx-font-size: 12px;"/>
            <VBox spacing="5">
                <Label text="Gérez vos"
                       style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                <Label text="Cours et Ressources"
                       style="-fx-text-fill: #f8c537; -fx-font-size: 36px; -fx-font-weight: bold;"/>
            </VBox>
            
            <Button text="+ Ajouter un cours" onAction="#onAjouterCoursClick"
                    style="-fx-background-color: white; -fx-text-fill: #7209b7;
                           -fx-font-weight: bold; -fx-font-size: 14px;
                           -fx-padding: 10 25 10 25; -fx-background-radius: 25; -fx-cursor: hand;"/>
        </VBox>
    </HBox>

    <!-- SECTION GLOBALE CONTENANT LES DEUX LISTES -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox style="-fx-background-color: #f0f0f5; -fx-padding: 20 40 20 40;" spacing="40">
            
            <!-- Section Mes Cours -->
            <VBox spacing="15">
                <Label text="Vos Cours"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <FlowPane fx:id="cardsContainer" hgap="20" vgap="20"/>
            </VBox>
            
            <!-- Ligne de séparation -->
            <Separator />

            <!-- Section Tous les Cours -->
            <VBox spacing="15">
                <Label text="Cours des autres Enseignants"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <FlowPane fx:id="allCardsContainer" hgap="20" vgap="20"/>
            </VBox>
            
        </VBox>
    </ScrollPane>

</VBox>
