<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.Controllers.PageAjouterCoursController"
      prefWidth="1200.0" prefHeight="700.0"
      style="-fx-background-color: #f0f0f5;">

    <!-- NAVBAR -->
    <HBox style="-fx-background-color: #3a0ca3; -fx-padding: 15 30 15 30;"
          alignment="CENTER" spacing="60">
        <Label text="🎓 InnoLearn"
               style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="60" HBox.hgrow="ALWAYS">
            <Button text="&lt; Retour aux Cours" onAction="#onAnnulerClick"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <VBox alignment="TOP_CENTER" maxWidth="600.0" spacing="20.0" 
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3); -fx-padding: 30;">
              
            <Label text="Créer un nouveau cours" 
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3a0ca3; -fx-padding: 0 0 20 0;" />

            <GridPane hgap="15.0" vgap="15.0" alignment="CENTER">
                <Label text="Titre du cours :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <TextField fx:id="tfTitre" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300.0" />
                
                <Label text="Description :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <TextArea fx:id="taDescription" styleClass="text-area" prefHeight="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300.0" />
                
                <Label text="Type de Média :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <ComboBox fx:id="cbTypeMedia" styleClass="combo-box" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                
                <Label text="URL du Média :" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <TextField fx:id="tfMediaUrl" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="300.0" />

                <Label text="Durée (en heures) :" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <TextField fx:id="tfDuree" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="300.0" />

                <Label text="Niveau :" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <ComboBox fx:id="cbNiveau" styleClass="combo-box" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <Label text="Catégorie :" GridPane.columnIndex="0" GridPane.rowIndex="6" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <ComboBox fx:id="cbCategorie" styleClass="combo-box" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            </GridPane>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <padding>
                    <Insets top="20.0" />
                </padding>
                <Button mnemonicParsing="false" onAction="#onAnnulerClick" text="Annuler" 
                        style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-weight: bold; -fx-cursor: hand;" />
                <Button mnemonicParsing="false" onAction="#onEnregistrerClick" text="Enregistrer" 
                        style="-fx-background-color: #3a0ca3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20 8 20; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </VBox>
</VBox>
