<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>

<VBox prefWidth="360.0" spacing="14.0" styleClass="external-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controllers.ExternalOfferItemController">
    <children>
        <!-- Header Row: Logo + Title/Company + Badge -->
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <!-- Company Logo Placeholder -->
                <StackPane styleClass="external-logo-container">
                    <children>
                        <SVGPath content="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8V9h8v10zm-2-8h-4v2h4v-2zm0 4h-4v2h4v-2z" fill="#6366f1" scaleX="0.9" scaleY="0.9" />
                    </children>
                </StackPane>

                <!-- Title + Company -->
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblTitle" styleClass="external-card-title" text="Software Engineer Intern" wrapText="true" />
                        <Label fx:id="lblCompany" styleClass="external-card-company" text="Global Tech Corp" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Meta Row: Location + Badge -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <!-- Location Box -->
                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="external-location-box">
                    <children>
                        <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="#6366f1" scaleX="0.65" scaleY="0.65" />
                        <Label fx:id="lblLocation" styleClass="external-card-location" text="New York, NY" />
                    </children>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Badge -->
                <Label styleClass="external-badge" text="🌍 INTERNATIONALE" />
            </children>
        </HBox>

        <!-- Separator -->
        <Region styleClass="external-card-separator" />

        <!-- Description -->
        <Text fx:id="txtDescription" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="external-card-description" text="Exciting internship opportunity..." wrappingWidth="310.0" />

        <Region VBox.vgrow="ALWAYS" />

        <!-- Apply Button -->
        <Button fx:id="btnApply" maxWidth="1.7976931348623157E308" onAction="#handleApply" styleClass="btn-external-apply" text="🔗  Voir sur la plateforme" />
    </children>
    <padding>
        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
    </padding>
</VBox>
