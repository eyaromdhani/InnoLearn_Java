<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.Controllers.PageAdminController"
      prefWidth="1200.0" prefHeight="700.0"
      style="-fx-background-color: #f0f0f5;">

    <!-- NAVBAR -->
    <HBox style="-fx-background-color: #1a1a2e; -fx-padding: 15 30 15 30;"
          alignment="CENTER" spacing="60">
        <Label text="👑 InnoLearn Admin"
               style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="60" HBox.hgrow="ALWAYS">
            <Button text="⬅ Déconnexion" onAction="#onRetourAccueilClick"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- HERO SECTION -->
    <HBox style="-fx-background-color: linear-gradient(to right, #1a1a2e, #16213e); -fx-padding: 40;"
          alignment="CENTER">
        <VBox alignment="CENTER" spacing="10">
            <Label text="Tableau de Bord Administrateur"
                   style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
            <Label text="Gérez les catégories et les cours du système."
                   style="-fx-text-fill: #a0a0b0; -fx-font-size: 16px;"/>
        </VBox>
    </HBox>

    <VBox alignment="CENTER" VBox.vgrow="ALWAYS" spacing="40">
        <HBox alignment="CENTER" spacing="50">
            <!-- CARTE COURS -->
            <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3); -fx-padding: 50; -fx-cursor: hand;"
                  onMouseClicked="#onGestionCoursClick">
                <Label text="📚" style="-fx-font-size: 60px;" />
                <Label text="Gestion des Cours" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <Label text="Gérer tous les cours (Ajouter, Modifier, Supprimer)" style="-fx-font-size: 14px; -fx-text-fill: #666;" />
                <Button text="Accéder" onAction="#onGestionCoursClick" style="-fx-background-color: #3a0ca3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30 10 30; -fx-cursor: hand;" />
            </VBox>
            
            <!-- CARTE CATEGORIES -->
            <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3); -fx-padding: 50; -fx-cursor: hand;"
                  onMouseClicked="#onGestionCategoriesClick">
                <Label text="📂" style="-fx-font-size: 60px;" />
                <Label text="Gestion des Catégories" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <Label text="Structurer la base avec des catégories (CRUD)" style="-fx-font-size: 14px; -fx-text-fill: #666;" />
                <Button text="Accéder" onAction="#onGestionCategoriesClick" style="-fx-background-color: #f72585; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30 10 30; -fx-cursor: hand;" />
            </VBox>

            <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3); -fx-padding: 50; -fx-cursor: hand;"
                  onMouseClicked="#onGestionEvenementsClick">
                <Label text="📅" style="-fx-font-size: 60px;" />
                <Label text="Gestion des Événements" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                <Label text="Gérer les inscriptions et les événements." style="-fx-font-size: 14px; -fx-text-fill: #666;" />
                <Button text="Accéder" onAction="#onGestionEvenementsClick" style="-fx-background-color: #4361ee; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30 10 30; -fx-cursor: hand;" />
            </VBox>

        </HBox>
    </VBox>
</VBox>
