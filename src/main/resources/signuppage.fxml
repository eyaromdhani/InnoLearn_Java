<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.SignUpPageController"
            prefWidth="1100" prefHeight="800" style="-fx-background-color: #1e1b4b;"
            stylesheets="@master.css">

    <HBox alignment="CENTER" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        
        <!-- Left Illustration Section -->
        <VBox alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS" style="-fx-padding: 50;">
            <StackPane>
                <Rectangle width="280" height="400" arcWidth="80" arcHeight="80"
                           fill="transparent" stroke="#8b5cf6" strokeWidth="3" opacity="0.4"/>
                <Group fx:id="idCardGroup">
                    <Rectangle width="160" height="220" arcWidth="30" arcHeight="30" 
                               fill="#2e1065" stroke="#a78bfa" strokeWidth="2"/>
                    <Circle centerX="80" centerY="80" radius="40" fill="#a78bfa" opacity="0.6"/>
                    <Rectangle x="40" y="140" width="80" height="10" arcWidth="5" arcHeight="5" fill="#a78bfa" opacity="0.6"/>
                    <Rectangle x="40" y="160" width="60" height="10" arcWidth="5" arcHeight="5" fill="#a78bfa" opacity="0.6"/>
                </Group>
            </StackPane>
            <VBox alignment="CENTER" spacing="10">
                <Label text="Start Your Journey" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: 900;"/>
                <Label text="Join thousands of scholars worldwide." 
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 16px;"/>
            </VBox>
        </VBox>

        <!-- Right Form Section -->
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-padding: 30;">
            <VBox maxWidth="550" styleClass="premium-card" style="-fx-background-radius: 40; -fx-padding: 40 50;">
                
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Enrollment" style="-fx-text-fill: #1e1b4b; -fx-font-size: 36px; -fx-font-weight: 900;"/>
                    <Label text="Create your professional academic identity." 
                           style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-style: italic;"/>
                </VBox>

                <VBox spacing="18" style="-fx-padding: 25 0 0 0;">
                    
                    <HBox spacing="15">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="FULL NAME" styleClass="label-caps"/>
                            <StackPane alignment="CENTER_RIGHT">
                                <TextField fx:id="nameField" promptText="Jihen Esprit" styleClass="pill-input"/>
                                <Button fx:id="micName" onAction="#startNameVoice" styleClass="mic-btn-inline"><graphic><Label text="🎙️"/></graphic></Button>
                            </StackPane>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="USERNAME" styleClass="label-caps"/>
                            <StackPane alignment="CENTER_RIGHT">
                                <TextField fx:id="usernameField" promptText="scholar_id" styleClass="pill-input"/>
                                <Button fx:id="micUser" onAction="#startUsernameVoice" styleClass="mic-btn-inline"><graphic><Label text="🎙️"/></graphic></Button>
                            </StackPane>
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="EMAIL ADDRESS" styleClass="label-caps"/>
                        <StackPane alignment="CENTER_RIGHT">
                            <TextField fx:id="emailField" promptText="scholar@innolearn.com" styleClass="pill-input"/>
                            <Button fx:id="micEmail" onAction="#startEmailVoice" styleClass="mic-btn-inline"><graphic><Label text="🎙️"/></graphic></Button>
                        </StackPane>
                    </VBox>

                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Label text="CODE" styleClass="label-caps"/>
                            <TextField fx:id="countryCodeField" text="+216" prefWidth="80" styleClass="pill-input"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="PHONE" styleClass="label-caps"/>
                            <StackPane alignment="CENTER_RIGHT">
                                <TextField fx:id="phoneField" promptText="55 123 456" styleClass="pill-input"/>
                                <Button fx:id="micPhone" onAction="#startPhoneVoice" styleClass="mic-btn-inline"><graphic><Label text="🎙️"/></graphic></Button>
                            </StackPane>
                        </VBox>
                    </HBox>

                    <HBox spacing="12" alignment="CENTER">
                        <ToggleButton fx:id="studentToggle" selected="true" text="🎓 STUDENT" style="-fx-background-radius: 20; -fx-padding: 8 15;"/>
                        <ToggleButton fx:id="teacherToggle" text="🏛️ TEACHER" style="-fx-background-radius: 20; -fx-padding: 8 15;"/>
                        <ToggleButton fx:id="partnerToggle" text="🤝 PARTNER" style="-fx-background-radius: 20; -fx-padding: 8 15;"/>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="PASSWORD" styleClass="label-caps"/>
                        <StackPane alignment="CENTER_RIGHT">
                            <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="pill-input"/>
                            <HBox spacing="5" alignment="CENTER_RIGHT" maxWidth="80" style="-fx-padding: 0 15 0 0;">
                                <Button fx:id="togglePasswordBtn" onAction="#togglePassword" style="-fx-background-color: transparent; -fx-cursor: hand;"><graphic><Label text="👁️"/></graphic></Button>
                                <Button fx:id="micPass" onAction="#startPasswordVoice" styleClass="mic-btn-inline"><graphic><Label text="🎙️"/></graphic></Button>
                            </HBox>
                        </StackPane>
                    </VBox>

                    <Button text="LET'S GO!" onAction="#handleSignup" maxWidth="Infinity" styleClass="btn-primary"/>

                    <HBox alignment="CENTER" spacing="8">
                        <Label text="Already have an account?" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                        <Hyperlink text="Login here" onAction="#goToLogin" style="-fx-text-fill: #7c3aed; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </HBox>
</AnchorPane>