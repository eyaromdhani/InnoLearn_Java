<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.Controllers.LoginPageController"
            prefWidth="1100" prefHeight="800" style="-fx-background-color: #1e1b4b;"
            stylesheets="@master.css">

    <HBox alignment="CENTER" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        
        <!-- LEFT SIDE: ILLUSTRATION -->
        <VBox alignment="CENTER" spacing="40" HBox.hgrow="ALWAYS" style="-fx-padding: 60;">
            <StackPane>
                <Rectangle width="220" height="340" arcWidth="80" arcHeight="80"
                           fill="transparent" stroke="#8b5cf6" strokeWidth="3" opacity="0.4"/>
                <Group fx:id="keyGroup">
                    <Rectangle width="100" height="150" arcWidth="30" arcHeight="30" 
                               fill="#2e1065" stroke="#a78bfa" strokeWidth="2"/>
                    <Circle centerX="50" centerY="60" radius="25" fill="#a78bfa" opacity="0.6"/>
                    <Rectangle x="45" y="85" width="10" height="40" fill="#a78bfa" opacity="0.6"/>
                </Group>
            </StackPane>
            <VBox alignment="CENTER" spacing="10">
                <Label text="Welcome Back" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: 900;"/>
                <Label text="Securely access your learning environment." 
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 15px;"/>
            </VBox>
        </VBox>

        <!-- RIGHT SIDE: LOGIN FORM -->
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-padding: 40;">
            <VBox maxWidth="550" styleClass="premium-card" style="-fx-background-radius: 40; -fx-padding: 50;">
                
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Sign In" style="-fx-text-fill: #1e1b4b; -fx-font-size: 40px; -fx-font-weight: 900;"/>
                    <Label text="Identify yourself to continue." 
                           style="-fx-text-fill: #64748b; -fx-font-size: 15px; -fx-font-style: italic;"/>
                </VBox>

                <VBox spacing="20" style="-fx-padding: 35 0 0 0;">
                    
                    <VBox spacing="8">
                        <Label text="USER IDENTIFIER" styleClass="label-caps"/>
                        <StackPane alignment="CENTER_RIGHT">
                            <TextField fx:id="emailField" promptText="Email or Username" styleClass="pill-input"/>
                            <Button fx:id="micEmail" onAction="#startEmailVoice" styleClass="mic-btn-inline"><graphic><Label text="🎙️"/></graphic></Button>
                        </StackPane>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="ACCESS KEY" styleClass="label-caps"/>
                        <StackPane alignment="CENTER_RIGHT">
                            <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="pill-input"/>
                            <Button fx:id="micPass" onAction="#startPasswordVoice" styleClass="mic-btn-inline"><graphic><Label text="🎙️"/></graphic></Button>
                        </StackPane>
                    </VBox>

                    <Label fx:id="errorMessage" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>

                    <Button text="AUTHORIZE ACCESS" onAction="#handleLogin" maxWidth="Infinity" styleClass="btn-primary"/>

                    <HBox alignment="CENTER" spacing="8">
                        <Label text="Need an identity?" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                        <Hyperlink text="Create account" onAction="#goToSignup" style="-fx-text-fill: #7c3aed; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </HBox>
</AnchorPane>
