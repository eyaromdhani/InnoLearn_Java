<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.ImageView?>

<ScrollPane fitToWidth="true" styleClass="main-scroll-pane" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controllers.StagesController">
    <content>
        <VBox spacing="0.0" styleClass="home-container">
            <children>
                <!-- Hero Full Container -->
                <VBox styleClass="hero-full-container" style="-fx-background-radius: 0;">
                    <children>
                        <!-- Navigation Bar (Included) -->
                        <fx:include fx:id="navbar" source="Navbar.fxml" />

                        <!-- Hero Section -->
                        <HBox alignment="CENTER_LEFT" spacing="40.0" styleClass="hero-section">
                            <children>
                                <!-- Hero Text Content -->
                                <VBox alignment="CENTER_LEFT" spacing="20.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" maxWidth="-Infinity" styleClass="hero-badge">
                                            <children>
                                                <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;" text="OPPORTUNITÉS PROFESSIONNELLES" />
                                            </children>
                                            <padding>
                                                <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
                                            </padding>
                                            <style>-fx-background-color: rgba(255, 255, 255, 0.1); -fx-background-radius: 20px;</style>
                                        </HBox>
                                        
                                        <VBox spacing="0.0">
                                            <children>
                                                <Label styleClass="hero-title" text="Trouvez Votre" />
                                                <Label styleClass="hero-title" style="-fx-text-fill: #ffa500;" text="Stage de Rêve" />
                                            </children>
                                        </VBox>
                                        
                                        <HBox alignment="CENTER" spacing="25.0" pickOnBounds="false" style="-fx-padding: 30 20 10 20;">
                                            <children>
                                                <!-- Card 1: Offres Disponibles -->
                                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label styleClass="kpi-label" text="OFFRES DISPONIBLES" />
                                                                        <Label fx:id="lblStatTotalOffres" styleClass="kpi-value" text="0" />
                                                                    </children>
                                                                </VBox>
                                                                <StackPane styleClass="kpi-icon-container" style="-fx-background-color: #f0f0ff;">
                                                                    <children>
                                                                        <SVGPath content="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" fill="#6366f1" />
                                                                    </children>
                                                                </StackPane>
                                                            </children>
                                                        </HBox>
                                                        <Region prefHeight="15.0" />
                                                        <ProgressBar maxWidth="1.7976931348623157E308" progress="0.7" styleClass="kpi-progress-blue" />
                                                    </children>
                                                </VBox>

                                                <!-- Card 2: Mes Candidatures -->
                                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label styleClass="kpi-label" text="MES CANDIDATURES" />
                                                                        <Label fx:id="lblStatMyApps" styleClass="kpi-value" text="0" />
                                                                    </children>
                                                                </VBox>
                                                                <StackPane styleClass="kpi-icon-container" style="-fx-background-color: #f0f4ff;">
                                                                    <children>
                                                                        <SVGPath content="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" fill="#6366f1" />
                                                                    </children>
                                                                </StackPane>
                                                            </children>
                                                        </HBox>
                                                        <Region prefHeight="15.0" />
                                                        <ProgressBar maxWidth="1.7976931348623157E308" progress="0.6" styleClass="kpi-progress-blue" />
                                                    </children>
                                                </VBox>

                                                <!-- Card 3: Acceptées -->
                                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label styleClass="kpi-label" text="ACCEPTÉES" />
                                                                        <Label fx:id="lblStatAccepted" styleClass="kpi-value" text="0" />
                                                                    </children>
                                                                </VBox>
                                                                <StackPane styleClass="kpi-icon-container" style="-fx-background-color: #e6ffef;">
                                                                    <children>
                                                                        <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="#22c55e" />
                                                                    </children>
                                                                </StackPane>
                                                            </children>
                                                        </HBox>
                                                        <Region prefHeight="15.0" />
                                                        <ProgressBar maxWidth="1.7976931348623157E308" progress="0.4" styleClass="kpi-progress-green" />
                                                    </children>
                                                </VBox>

                                                <!-- Card 4: En Attente -->
                                                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT">
                                                            <children>
                                                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label styleClass="kpi-label" text="EN ATTENTE" />
                                                                        <Label fx:id="lblStatPending" styleClass="kpi-value" text="0" />
                                                                    </children>
                                                                </VBox>
                                                                <StackPane styleClass="kpi-icon-container" style="-fx-background-color: #fff9e6;">
                                                                    <children>
                                                                        <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="#fab005" />
                                                                    </children>
                                                                </StackPane>
                                                            </children>
                                                        </HBox>
                                                        <Region prefHeight="15.0" />
                                                        <ProgressBar maxWidth="1.7976931348623157E308" progress="0.1" styleClass="kpi-progress-gray" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        
                                        <Region prefHeight="40.0" />
                                        
                                        <!-- Hero Floating Tab Bar -->
                                        <HBox alignment="CENTER_LEFT" fillHeight="false" prefHeight="65.0" spacing="15.0" styleClass="hero-tabs-container">
                                            <children>
                                                <!-- Tab 1: Offers (Active) -->
                                                <HBox fx:id="tabOffres" alignment="CENTER" minHeight="45.0" minWidth="180.0" onMouseClicked="#handleShowOffres" spacing="12.0" styleClass="hero-tab-item hero-tab-item-active">
                                                    <children>
                                                        <SVGPath content="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" styleClass="hero-tab-icon" />
                                                        <Label styleClass="hero-tab-label" text="Les offres" />
                                                    </children>
                                                </HBox>
                                                
                                                <!-- Tab 2: Demandes -->
                                                <HBox fx:id="tabDemandes" alignment="CENTER" minHeight="45.0" minWidth="240.0" onMouseClicked="#handleShowDemandes" spacing="12.0" styleClass="hero-tab-item">
                                                    <children>
                                                        <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" styleClass="hero-tab-icon" />
                                                        <Label styleClass="hero-tab-label" text="Les demandes publiées" />
                                                    </children>
                                                </HBox>

                                                <!-- Tab 3: Mon Profil -->
                                                <HBox fx:id="tabProfile" alignment="CENTER" minHeight="45.0" minWidth="200.0" onMouseClicked="#handleShowProfile" spacing="12.0" styleClass="hero-tab-item">
                                                    <children>
                                                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" styleClass="hero-tab-icon" />
                                                        <Label styleClass="hero-tab-label" text="Mon Profil" />
                                                    </children>
                                                </HBox>

                                                <!-- Tab 4: Réponses -->
                                                <HBox fx:id="tabInsights" alignment="CENTER" minHeight="45.0" minWidth="150.0" onMouseClicked="#handleShowInsights" spacing="12.0" styleClass="hero-tab-item">
                                                    <children>
                                                        <SVGPath content="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z" styleClass="hero-tab-icon" />
                                                        <Label styleClass="hero-tab-label" text="Mes Réponses" />
                                                    </children>
                                                </HBox>

                                                <!-- Tab 5: External Offers -->
                                                <HBox fx:id="tabExternal" alignment="CENTER" minHeight="45.0" minWidth="220.0" onMouseClicked="#handleShowExternal" spacing="12.0" styleClass="hero-tab-item">
                                                    <children>
                                                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" styleClass="hero-tab-icon" />
                                                        <Label styleClass="hero-tab-label" text="Opportunités Externes" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                
                                <!-- Hero 3D Illustration -->
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <children>
                                        <StackPane styleClass="hero-image-container">
                                            <children>
                                                <Circle fx:id="heroCircle" radius="240.0" styleClass="hero-circle-image" />
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>
                            </children>
                            <padding>
                                <Insets bottom="80.0" left="80.0" right="80.0" top="40.0" />
                            </padding>
                        </HBox>
                        
                        <!-- Wavy Bottom Divider -->
                        <!-- Wavy Bottom Divider (Stretched) -->
                        <Region styleClass="wavy-separator" VBox.vgrow="NEVER" />
                    </children>
                </VBox>
                
                <!-- Main Content Area -->
                <ScrollPane fx:id="scrollPaneContent" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="20.0" style="-fx-padding: 0 40 40 40;">
                            <!-- Modern Filter Area -->
                            <VBox fx:id="filterArea" spacing="20.0" styleClass="filter-row">
                                <children>
                                    <!-- Row 1: Search, Company, Domain, Recommendation -->
                                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                                        <children>
                                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-input-container" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" styleClass="filter-icon" />
                                                    <TextField fx:id="txtSearch" promptText="Rechercher une offre..." HBox.hgrow="ALWAYS" />
                                                </children>
                                            </HBox>
                                            
                                            <HBox fx:id="containerEntreprise" alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-input-container" prefWidth="250.0">
                                                <children>
                                                    <SVGPath content="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm14 12h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V9h2v2zm0-4h-2V5h2v2zm-2 1h-8v8h8v-8z" styleClass="filter-icon" />
                                                    <ComboBox fx:id="comboEntreprise" promptText="Toutes les entreprises" prefWidth="200.0" />
                                                </children>
                                            </HBox>

                                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-input-container" prefWidth="250.0">
                                                <children>
                                                    <SVGPath content="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6 10H6v-2h8v2zm4-4H6v-2h12v2z" styleClass="filter-icon" />
                                                    <ComboBox fx:id="comboDomaine" promptText="Tous les domaines" prefWidth="200.0" />
                                                </children>
                                            </HBox>

                                            <Button fx:id="btnRecommendationAI" onAction="#handleRecommendations" styleClass="btn-recommendation" text="🪄 Recommandation AI" />
                                        </children>
                                    </HBox>

                                    <!-- Row 2: Duration, Sort -->
                                    <HBox fx:id="filterRow2" alignment="CENTER_LEFT" spacing="15.0">
                                        <children>
                                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-input-container" prefWidth="180.0">
                                                <children>
                                                    <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" styleClass="filter-icon" />
                                                    <ComboBox fx:id="comboDuree" promptText="Durées" prefWidth="130.0" />
                                                </children>
                                            </HBox>

                                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-input-container" prefWidth="180.0">
                                                <children>
                                                    <SVGPath content="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" styleClass="filter-icon" />
                                                    <ComboBox fx:id="comboSort" promptText="Plus récents" prefWidth="130.0" />
                                                </children>
                                            </HBox>

                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                            
                            <!-- FlowPane for Cards -->
                            <FlowPane fx:id="contentArea" hgap="30.0" rowValignment="TOP" styleClass="content-area" vgap="30.0">
                                <!-- Cards will be injected here -->
                            </FlowPane>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </content>
</ScrollPane>
