<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="30.0" style="-fx-background-color: #f8fafc; -fx-padding: 30;" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.StudentResponsesController">
    <children>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <SVGPath content="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z" fill="#6366f1" scaleX="1.2" scaleY="1.2" />
                <Label style="-fx-font-size: 24; -fx-font-weight: 800; -fx-text-fill: #1e293b;" text="Suivi de mes Réponses" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#refresh" styleClass="btn-secondary" text="Actualiser" />
            </children>
        </HBox>

        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="admin-tab-pane">
            <tabs>
                <Tab text="Candidatures aux offres">
                    <content>
                        <VBox spacing="20.0" style="-fx-padding: 30 0 0 0;">
                            <children>
                                <FlowPane fx:id="containerCandidatures" hgap="30.0" vgap="30.0" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Mes Demandes publiées">
                    <content>
                        <VBox spacing="20.0" style="-fx-padding: 30 0 0 0;">
                            <children>
                                <FlowPane fx:id="containerDemandes" hgap="30.0" vgap="30.0" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>
