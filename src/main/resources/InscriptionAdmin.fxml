<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane stylesheets="@styles.css" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.GestionInscriptionController">
   <children>
      <ScrollPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" fitToWidth="true" styleClass="scroll-pane">
   <content>
      <VBox spacing="0.0">
         <children>
            <!-- Navigation Bar -->
            <HBox styleClass="nav-bar" spacing="15.0">
               <children>
                  <Label text="🎓 InnoLearn Admin" styleClass="nav-logo" />
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox spacing="20.0" alignment="CENTER">
                      <Button text="Événements" styleClass="nav-link" onAction="#retour" />
                      <Button text="Inscriptions" styleClass="nav-link" style="-fx-underline: true;" />
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnretour" text="Retour Événements" styleClass="btn-secondary" onAction="#retour" />
               </children>
            </HBox>

            <!-- Hero Section -->
            <VBox styleClass="hero-bg" spacing="10.0">
               <children>
                  <Label text="PANEL D'ADMINISTRATION" styleClass="hero-tag" />
                  <Label text="Gestion des Inscriptions" styleClass="hero-title-white" style="-fx-font-size: 32px;" />
                  <Label text="Validez ou rejetez les demandes de participation des étudiants." style="-fx-text-fill: white; -fx-opacity: 0.8;" />
               </children>
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
               </padding>
            </VBox>

            <!-- Content Area -->
            <VBox alignment="CENTER" style="-fx-padding: 30 40 40 40;">
                <children>
                    <VBox maxWidth="700.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                        <children>
                            <Label text="Demandes en attente" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2D1A6A;" />
                            
                            <ListView fx:id="lvinscriptions" prefHeight="300.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E0E0E0;" />
                            
                            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                <children>
                                    <Button fx:id="btnsupprimer" onAction="#supprimerInscription" styleClass="btn-danger" text="Rejeter / Supprimer" style="-fx-font-size: 13px; -fx-padding: 8 20;" />
                                    <Button fx:id="btnconfirmer" onAction="#confirmerInscription" styleClass="btn-primary" text="Confirmer l'inscription" style="-fx-font-size: 13px; -fx-padding: 8 20;" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </children>
            </VBox>
         </children>
      </VBox>
   </content>
      </ScrollPane>
   </children>
</AnchorPane>
