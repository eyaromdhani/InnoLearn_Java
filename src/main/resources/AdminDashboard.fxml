<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AdminDashboardController"
      stylesheets="@modern_style.css"
      styleClass="main-bg"
      prefHeight="800.0" prefWidth="1200.0">

    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" spacing="30" styleClass="top-nav-bar">
        <Label text="InnoLearn" styleClass="nav-logo"/>
        
        <HBox alignment="CENTER" spacing="10">
            <Button text="Accueil" styleClass="nav-button" onAction="#handleGoToAccueil"/>
            <Button text="Mes Cours" styleClass="nav-button"/>
            <Button text="Bibliothèque" styleClass="nav-button" onAction="#handleGoToBooks"/>
            <Button text="Quiz" styleClass="nav-button, nav-button-active"/>
        </HBox>
        
        <Region HBox.hgrow="ALWAYS" />
        
        <HBox alignment="CENTER" spacing="15" styleClass="user-profile-btn">
            <Label text="InnoLearn Teacher" style="-fx-text-fill: #6366F1; -fx-font-weight: bold;"/>
            <Circle radius="12" fill="#6366F1"/>
        </HBox>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="0">
            <!-- Hero Section -->
            <VBox spacing="15" styleClass="hero-gradient" style="-fx-padding: 60 100;">
                <Label text="ESPACE ENSEIGNANT" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-padding: 5 15; -fx-background-radius: 20; -fx-font-size: 12px;"/>
                <Label text="Gérez et" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Optimisez Vos Quiz" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #FECACA;"/>
                
                <VBox spacing="10">
                    <ComboBox fx:id="categoryFilter" promptText="Toutes les catégories" styleClass="combo-box-custom" prefWidth="250"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Rechercher un quiz..." styleClass="text-field-custom" prefWidth="300"/>
                        <ComboBox fx:id="sortByCombo" promptText="Trier par..." styleClass="combo-box-custom" prefWidth="180"/>
                        <Button text="Créer un Quiz" styleClass="button-primary" onAction="#handleCreateQuiz"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Grid Section -->
            <VBox spacing="30" style="-fx-padding: 40 100;">
                <FlowPane fx:id="quizGrid" hgap="30" vgap="30" alignment="CENTER_LEFT">
                    <!-- Cards will be injected here -->
                </FlowPane>
            </VBox>
        </VBox>
    </ScrollPane>

</VBox>
